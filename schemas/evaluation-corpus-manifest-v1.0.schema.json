{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LLOYD-11/cloud_security_misconfiguration_lab/schemas/evaluation-corpus-manifest-v1.0.schema.json",
  "title": "Independent Evaluation Corpus Manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "corpus_version",
    "status",
    "frozen_on",
    "description",
    "protocol",
    "candidate_revision",
    "independence",
    "case_count",
    "file_count",
    "cases",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "corpus_id": { "const": "cloud-security-independent-corpus" },
    "corpus_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "status": { "const": "frozen" },
    "frozen_on": { "type": "string", "format": "date" },
    "description": { "$ref": "#/$defs/nonEmptyText" },
    "protocol": { "$ref": "#/$defs/versionedArtifact" },
    "candidate_revision": { "$ref": "#/$defs/commitSha" },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "candidate_output_seen_during_authoring",
        "reused_project_fixture_count",
        "reused_project_expectation_count",
        "statement"
      ],
      "properties": {
        "model": { "enum": ["procedural", "personnel"] },
        "candidate_output_seen_during_authoring": { "const": false },
        "reused_project_fixture_count": { "const": 0 },
        "reused_project_expectation_count": { "const": 0 },
        "statement": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "case_count": { "type": "integer", "minimum": 1 },
    "file_count": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "path_policy", "inventory_policy"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "path_policy": { "const": "repository-relative-regular-files-no-symlinks" },
        "inventory_policy": { "const": "every-corpus-file-declared-exactly-once" }
      }
    }
  },
  "$defs": {
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "moduleId": { "enum": ["iam", "storage", "network", "cloudtrail"] },
    "ruleId": { "type": "string", "pattern": "^(?:IAM|STO|NET|CLD)-[0-9]{3}$" },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "versionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^evaluation/protocol-v[0-9]+\\.[0-9]+\\.json$" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type", "contract"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^evaluation/corpus-v[0-9]+\\.[0-9]+/(?:iam|storage|network|cloudtrail)/(?:[A-Za-z0-9_][A-Za-z0-9._-]*/)*[A-Za-z0-9_][A-Za-z0-9._-]*$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "media_type": {
          "enum": [
            "application/json",
            "application/gzip",
            "text/csv"
          ]
        },
        "contract": {
          "type": "string",
          "pattern": "^(?:schemas/[a-z0-9.-]+\\.schema\\.json|cloud_security_lab/normalizers/iam\\.py)$"
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "title", "url", "retrieved_on", "locator"],
      "properties": {
        "authority": { "enum": ["aws", "ietf", "nist", "project-upstream"] },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "retrieved_on": { "type": "string", "format": "date" },
        "locator": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "reviewPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_on", "candidate_output_seen", "notes"],
      "properties": {
        "reviewer_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "reviewed_on": { "type": "string", "format": "date" },
        "candidate_output_seen": { "const": false },
        "notes": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "resource_type",
        "resource_id",
        "label",
        "expected_severity",
        "rationale",
        "authoritative_references",
        "review"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^AST-(?:IAM|STO|NET|CLD)-[0-9]{3}-[0-9]{2}$" },
        "rule_id": { "$ref": "#/$defs/ruleId" },
        "resource_type": { "$ref": "#/$defs/nonEmptyText" },
        "resource_id": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "enum": ["positive", "negative", "ambiguous", "unsupported"] },
        "expected_severity": {
          "oneOf": [
            { "$ref": "#/$defs/severity" },
            { "type": "null" }
          ]
        },
        "rationale": { "$ref": "#/$defs/nonEmptyText" },
        "authoritative_references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" },
          "contains": {
            "type": "object",
            "properties": { "authority": { "const": "aws" } },
            "required": ["authority"]
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "primary", "verification", "resolution"],
          "properties": {
            "model": { "enum": ["procedural", "personnel"] },
            "primary": { "$ref": "#/$defs/reviewPass" },
            "verification": { "$ref": "#/$defs/reviewPass" },
            "resolution": { "enum": ["agreed", "adjudicated", "unresolved"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "label": { "const": "positive" } }, "required": ["label"] },
          "then": { "properties": { "expected_severity": { "$ref": "#/$defs/severity" } } },
          "else": { "properties": { "expected_severity": { "type": "null" } } }
        },
        {
          "if": { "properties": { "label": { "const": "ambiguous" } }, "required": ["label"] },
          "then": { "properties": { "review": { "properties": { "resolution": { "const": "unresolved" } } } } }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "classification",
        "title",
        "description",
        "origins",
        "input_variants",
        "assertions",
        "provenance",
        "baseline_eligible"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^EVAL-(?:IAM|STO|NET|CLD)-[0-9]{3}$" },
        "module": { "$ref": "#/$defs/moduleId" },
        "classification": { "enum": ["positive", "hardened-negative", "boundary", "ambiguous"] },
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "description": { "$ref": "#/$defs/nonEmptyText" },
        "origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "independently-authored-synthetic",
              "official-documentation-derived",
              "public-open-source-derived"
            ]
          }
        },
        "input_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "input_form", "equivalence_group", "files"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "input_form": { "enum": ["native", "simplified"] },
              "equivalence_group": {
                "oneOf": [
                  { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                  { "type": "null" }
                ]
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/file" }
              }
            }
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authored_on", "source_references", "transformations", "sanitization", "candidate_output_seen"],
          "properties": {
            "authored_on": { "type": "string", "format": "date" },
            "source_references": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/sourceReference" }
            },
            "transformations": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmptyText" }
            },
            "sanitization": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmptyText" }
            },
            "candidate_output_seen": { "const": false }
          }
        },
        "baseline_eligible": { "type": "boolean" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "module": { "const": "iam" },
                "id": { "pattern": "^EVAL-IAM-[0-9]{3}$" },
                "input_variants": {
                  "items": {
                    "properties": {
                      "files": {
                        "items": {
                          "properties": {
                            "path": { "pattern": "^evaluation/corpus-v[0-9]+\\.[0-9]+/iam/" }
                          }
                        }
                      }
                    }
                  }
                },
                "assertions": {
                  "items": {
                    "properties": {
                      "id": { "pattern": "^AST-IAM-[0-9]{3}-[0-9]{2}$" },
                      "rule_id": { "pattern": "^IAM-[0-9]{3}$" }
                    }
                  }
                }
              },
              "required": ["module"]
            },
            {
              "properties": {
                "module": { "const": "storage" },
                "id": { "pattern": "^EVAL-STO-[0-9]{3}$" },
                "input_variants": {
                  "items": {
                    "properties": {
                      "files": {
                        "items": {
                          "properties": {
                            "path": { "pattern": "^evaluation/corpus-v[0-9]+\\.[0-9]+/storage/" }
                          }
                        }
                      }
                    }
                  }
                },
                "assertions": {
                  "items": {
                    "properties": {
                      "id": { "pattern": "^AST-STO-[0-9]{3}-[0-9]{2}$" },
                      "rule_id": { "pattern": "^STO-[0-9]{3}$" }
                    }
                  }
                }
              },
              "required": ["module"]
            },
            {
              "properties": {
                "module": { "const": "network" },
                "id": { "pattern": "^EVAL-NET-[0-9]{3}$" },
                "input_variants": {
                  "items": {
                    "properties": {
                      "files": {
                        "items": {
                          "properties": {
                            "path": { "pattern": "^evaluation/corpus-v[0-9]+\\.[0-9]+/network/" }
                          }
                        }
                      }
                    }
                  }
                },
                "assertions": {
                  "items": {
                    "properties": {
                      "id": { "pattern": "^AST-NET-[0-9]{3}-[0-9]{2}$" },
                      "rule_id": { "pattern": "^NET-[0-9]{3}$" }
                    }
                  }
                }
              },
              "required": ["module"]
            },
            {
              "properties": {
                "module": { "const": "cloudtrail" },
                "id": { "pattern": "^EVAL-CLD-[0-9]{3}$" },
                "input_variants": {
                  "items": {
                    "properties": {
                      "files": {
                        "items": {
                          "properties": {
                            "path": { "pattern": "^evaluation/corpus-v[0-9]+\\.[0-9]+/cloudtrail/" }
                          }
                        }
                      }
                    }
                  }
                },
                "assertions": {
                  "items": {
                    "properties": {
                      "id": { "pattern": "^AST-CLD-[0-9]{3}-[0-9]{2}$" },
                      "rule_id": { "pattern": "^CLD-[0-9]{3}$" }
                    }
                  }
                }
              },
              "required": ["module"]
            }
          ]
        },
        {
          "if": {
            "properties": { "classification": { "const": "positive" } },
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "assertions": {
                "contains": {
                  "type": "object",
                  "properties": { "label": { "const": "positive" } },
                  "required": ["label"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "classification": { "const": "hardened-negative" } },
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "assertions": {
                "items": {
                  "properties": { "label": { "const": "negative" } }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "classification": { "const": "ambiguous" } },
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "assertions": {
                "contains": {
                  "type": "object",
                  "properties": { "label": { "const": "ambiguous" } },
                  "required": ["label"]
                }
              }
            }
          }
        }
      ]
    }
  }
}
